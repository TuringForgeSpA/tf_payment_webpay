<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_transaction_form" model="ir.ui.view">
        <field name="name">WebPay Transaction Form</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <field name="provider_reference" position="after">
                <field name="webpay_token" invisible="provider_code != 'webpay'"/>
                <field name="webpay_buy_order" invisible="provider_code != 'webpay'"/>
                <field name="webpay_payment_type_code" invisible="provider_code != 'webpay'"/>
                <field name="webpay_installments_number"
                       invisible="provider_code != 'webpay' or not webpay_installments_number"/>
                <field name="webpay_card_number"
                       invisible="provider_code != 'webpay' or not webpay_card_number"/>
            </field>
        </field>
    </record>

</odoo>
